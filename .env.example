# Hyperliquid Trading SaaS - Environment Variables
# Copy this file to .env and update with your values

# ============================================
# REQUIRED VARIABLES
# ============================================

# MongoDB Connection (Railway MongoDB or MongoDB Atlas)
# Example: mongodb+srv://user:password@cluster.mongodb.net/hyperliquid_saas
MONGO_URI=mongodb://localhost:27017

# Database Name
MONGO_DB=hyperliquid_saas

# JWT Secret (REQUIRED - Generate with: openssl rand -base64 64)
JWT_SECRET=

# ============================================
# PAYMENT WALLETS (REQUIRED for payments)
# ============================================

# Solana Wallet Address
SOL_WALLET=

# Ethereum Wallet Address
ETH_WALLET=

# ============================================
# RPC ENDPOINTS (Optional - defaults provided)
# ============================================

# Solana RPC
SOL_RPC=https://api.mainnet-beta.solana.com

# Ethereum RPC
ETH_RPC=https://eth.llamarpc.com

# ============================================
# HYPERLIQUID API (Optional - defaults provided)
# ============================================

HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws

# ============================================
# ADMIN CREDENTIALS (Change after first login!)
# ============================================

ADMIN_EMAIL=admin@railway.app
ADMIN_PASSWORD=admin123

# ============================================
# RAILWAY VARIABLES (Auto-set by Railway)
# ============================================

# PORT - Automatically set by Railway
# PORT=8080

# RAILWAY_ENVIRONMENT - production, staging, or development
# RAILWAY_ENVIRONMENT=production

# ============================================
# OPTIONAL SETTINGS
# ============================================

# Log Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Session Lifetime (seconds)
SESSION_LIFETIME=86400

# Max Login Attempts
MAX_LOGIN_ATTEMPTS=5
